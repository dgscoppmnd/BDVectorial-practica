# Copia este archivo como .env y completa solo los proveedores que vayas a usar.
# URL del servidor Qdrant (docker compose up -d). Sin servidor, el notebook
# cae automáticamente al modo local persistente del SDK (./qdrant_local).
QDRANT_URL=http://localhost:6333

OPENAI_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
PYTHONPATH=.

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
COHERE_EMBEDDING_MODEL=embed-v4.0
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-small
